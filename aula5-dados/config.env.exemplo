# Copie para config.env e preencha com os valores da dupla:
#   cp config.env.exemplo config.env && code config.env
# Cole as connection strings inteiras, sem aspas.

# Só o nome do namespace, sem .servicebus.windows.net
EVENTHUB_NAMESPACE=eh-SUADUPLA-aula5

# Namespace > Settings > Shared access policies > RootManageSharedAccessKey
EVENTHUB_CONNECTION=Endpoint=sb://...

# Storage account > Security + networking > Access keys > key1 > Connection string
STORAGE_CONNECTION=DefaultEndpointsProtocol=https;...

# http://IP-DA-API:8000 (o roteiro mostra como descobrir o IP)
API_URL=http://0.0.0.0:8000
